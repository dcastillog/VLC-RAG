# Copy to .env and fill in. .env is gitignored.
#
# GROBID_URL      - base URL of the GROBID service (Docker container).
#                   Defaults to http://localhost:8070 if unset.
# CROSSREF_MAILTO - your email; sent as ?mailto= to the Crossref API so they can
#                   contact you instead of rate-limiting anonymously. Required.
# UNPAYWALL_EMAIL - your email; required query param for the Unpaywall API. Required.

GROBID_URL=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=
