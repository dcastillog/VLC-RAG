# Copy to .env and fill in. .env is gitignored.
#
# GROBID_URL      - base URL of the GROBID service (Docker container).
#                   Defaults to http://localhost:8070 if unset.
# CROSSREF_MAILTO - your email; sent as ?mailto= to the Crossref API so they can
#                   contact you instead of rate-limiting anonymously. Required.
# UNPAYWALL_EMAIL - your email; required query param for the Unpaywall API. Required.
#
# LLM_BASE_URL    - base URL of the OpenAI-compatible chat-completions endpoint.
#                   Defaults to http://localhost:11434/v1 (Ollama, running natively
#                   on the host). Point this at a hosted provider to switch -- no
#                   code change (see src/ragvlc/generation/client.py).
# LLM_MODEL       - model name passed to the endpoint, e.g. qwen3:4b. Required.
# LLM_API_KEY     - bearer token for the endpoint. Defaults to "ollama", which a
#                   local Ollama ignores; set a real key for a hosted provider.

GROBID_URL=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama
